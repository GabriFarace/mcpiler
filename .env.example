# Select the OpenAI-compatible endpoint used by the live semantic analyzer.
# Supported MVP profiles: lmstudio or openai.
SEMANTIC_LLM_PROVIDER=lmstudio

# Required for both profiles. Use the model identifier exposed by the endpoint.
SEMANTIC_LLM_MODEL=

# LM Studio defaults. For OpenAI cloud, use https://api.openai.com/v1.
SEMANTIC_LLM_BASE_URL=http://127.0.0.1:1234/v1

# LM Studio accepts a placeholder value. Never commit a real cloud API key.
SEMANTIC_LLM_API_KEY=lm-studio

# Shared bounded-call settings.
SEMANTIC_LLM_TEMPERATURE=0
SEMANTIC_LLM_TIMEOUT_SECONDS=60
SEMANTIC_LLM_MAX_RETRIES=1

# OpenAI cloud example:
# SEMANTIC_LLM_PROVIDER=openai
# SEMANTIC_LLM_MODEL=<model-id>
# SEMANTIC_LLM_BASE_URL=https://api.openai.com/v1
# SEMANTIC_LLM_API_KEY=<secret>
