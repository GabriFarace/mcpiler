# Approved local OpenAI-compatible profile. Set the model identifier exposed by
# LM Studio; the placeholder API key is non-secret.
MCPILER_LIVE_MODEL=
MCPILER_LIVE_BASE_URL=http://127.0.0.1:1234/v1
MCPILER_LIVE_API_KEY=lm-studio
MCPILER_LIVE_TIMEOUT_SECONDS=30
MCPILER_LIVE_MAX_RETRIES=1

# The analyzer also disables tracing in-process so bounded source and responses
# cannot be exported through ambient LangSmith callbacks.
LANGSMITH_TRACING=false
